# PostgreSQL холболт.
# Локал (docker compose up -d):  postgresql://medipass:medipass@localhost:5432/medipass
# Neon / Supabase / Vercel Postgres:  холбоосоо энд тавина (…?sslmode=require)
DATABASE_URL="postgresql://medipass:medipass@localhost:5432/medipass"

# Сешн (JWT) гарын үсгийн нууц түлхүүр — дор хаяж 32 тэмдэгт
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Эрүүл мэндийн мэдээллийг шифрлэх AES-256 түлхүүр — 64 hex тэмдэгт (32 байт)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Сайтын бүрэн хаяг (QR код дотор орох URL)
# Локал дээр ХООСОН орхино (нээгдсэн хаягийг автоматаар ашиглана).
# Vercel дээр өөрийн домэйнээ тавина, жишээ: https://medipass.vercel.app
# (production дээр localhost утга автоматаар үл тооцогдоно)
NEXT_PUBLIC_APP_URL=""

# ---- Нэмэлт (заавал биш) ----

# Нууц үг сэргээх имэйл илгээх — https://resend.com (үнэгүй багцтай).
# Тохируулаагүй үед локал дээр сэргээх холбоос терминалд хэвлэгдэнэ.
RESEND_API_KEY=""
MAIL_FROM="MediPass <no-reply@your-domain.mn>"

# /api/cron/cleanup (Vercel Cron) хамгаалах нууц үг — дурын урт санамсаргүй тэмдэгт мөр
CRON_SECRET=""

# ENCRYPTION_KEY солих үед л хэрэгтэй — README-ийн "Түлхүүр солих" хэсгийг үз
# ENCRYPTION_KEY_OLD=""
